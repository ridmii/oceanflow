# ─── Copernicus Marine credentials ───────────────────────────────────────────
# Option A: Fill these in to use password-based auth in scripts.
# Option B: Leave blank and run `copernicusmarine login` once.
COPERNICUS_USERNAME=your_email@example.com
COPERNICUS_PASSWORD=your_password

# ─── Dataset ─────────────────────────────────────────────────────────────────
# The Copernicus Marine dataset ID to use for downloading currents.
COPERNICUS_DATASET_ID=cmems_mod_glo_phy_anfc_merged-uv_PT1H-i

# ─── API Server & Worker Settings ─────────────────────────────────────────────
# Redis connection URL for Celery and WebSocket PubSub
REDIS_URL=redis://redis:6379/0

# Root directory for storing run data (meta.json, frames, density)
DATA_DIR=/data

# Maximum number of concurrently running simulation tasks
MAX_CONCURRENT_SIMULATIONS=1

# Rate limit for submitting new simulations per client IP
RATE_LIMIT_PER_MINUTE=5

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ─── WebSocket Streaming ──────────────────────────────────────────────────────
# Send a ping every N seconds to keep idle connections alive
WS_HEARTBEAT_SECONDS=15

# Polling interval (seconds) to check for DONE/FAILED markers on disk
WS_MARKER_POLL_SECONDS=5

# ─── Density Frame Generation ─────────────────────────────────────────────────
# Gaussian blur sigma applied to the density heatmap
DENSITY_BLUR_SIGMA=0.8

# Default grid width for density frames
DENSITY_DEFAULT_COLS=720

# Default grid height for density frames
DENSITY_DEFAULT_ROWS=360
