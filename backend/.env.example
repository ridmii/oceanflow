# ─── Copernicus Marine credentials ───────────────────────────────────────────
# These are used by scripts/test_connection.py and scripts/download_test_subset.py.
# Do NOT commit this file. It is listed in .gitignore.
#
# Option A: Fill these in to use password-based auth in scripts.
# Option B: Leave blank and run `copernicusmarine login` once; the toolbox
#            will cache a token in ~/.copernicusmarine/ automatically.
COPERNICUS_USERNAME=heyridmi@gmail.com
COPERNICUS_PASSWORD=LRxbzpH6e2mbL_F

# ─── Dataset ─────────────────────────────────────────────────────────────────
# Fill this in AFTER running: python scripts/discover_datasets.py
# Example: cmems_mod_glo_phy_anfc_0.083deg_P1D-m
COPERNICUS_DATASET_ID=cmems_mod_glo_phy_anfc_merged-uv_PT1H-i

# ─── Variables to download ───────────────────────────────────────────────────
# uo = eastward sea water velocity
# vo = northward sea water velocity
COPERNICUS_VARIABLES=uo,vo

# ─── Simulation region (degrees) ─────────────────────────────────────────────
SIMULATION_REGION_WEST=-160
SIMULATION_REGION_EAST=-120
SIMULATION_REGION_SOUTH=20
SIMULATION_REGION_NORTH=50

# ─── Simulation time window ───────────────────────────────────────────────────
# Keep the window ≤ 7 days for test downloads (download_test_subset.py enforces this).
SIMULATION_START_DATE=2024-01-01
SIMULATION_END_DATE=2024-01-02

# ─── Depth filter ────────────────────────────────────────────────────────────
# Surface layer only. Max depth in metres.
SIMULATION_MAX_DEPTH=1
